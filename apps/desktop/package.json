{
  "name": "truetrace-desktop",
  "version": "1.0.0",
  "description": "TrueTrace AI — Dedicated Windows Security Desktop Client",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.truetrace.desktop",
    "productName": "TrueTrace AI",
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "web-dist/**/*"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  }
}
