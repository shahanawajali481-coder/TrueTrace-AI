# TrueTrace AI Backend Configuration
PROJECT_NAME="TrueTrace AI"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-32-character-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; configure PostgreSQL in production)
DATABASE_URL="sqlite:///./truetrace.db"
# DATABASE_URL="postgresql://truetrace:secret_password@localhost:5432/truetrace_db"

# Optional External Intelligence Integrations (Leave empty for graceful mock fallback)
HIBP_API_KEY=""
VIRUSTOTAL_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional Meta Graph API Integration (Requires Meta App Review for live profile data)
META_APP_ID=""
META_APP_SECRET=""
META_ACCESS_TOKEN=""

# DNS Settings
DNS_TIMEOUT_SECONDS=3.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
